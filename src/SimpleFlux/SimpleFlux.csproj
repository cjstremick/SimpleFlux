<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ImplicitUsings, Nullable, Authors etc. come from Directory.Build.props -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    VersionPrefix is the local default. CI overrides the full version at pack time
    with `-p:Version=X.Y.Z` or `-p:Version=X.Y.Z-prerelease.N` (see RELEASING.md).
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SimpleFlux</PackageId>
    <PackageTags>Event store;Event Streaming;Database</PackageTags>
    <Title>A simple event stream database engine based on Azure Table Storage.</Title>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ship the README inside the NuGet package so nuget.org shows it on the package page. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
  </ItemGroup>

</Project>