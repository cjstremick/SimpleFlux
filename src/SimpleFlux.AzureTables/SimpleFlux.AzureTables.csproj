<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ImplicitUsings / Nullable / package metadata come from Directory.Build.props -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>2.0.0</VersionPrefix>
  </PropertyGroup>

  <!-- Per-package NuGet metadata (the rest is shared via Directory.Build.props). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <PackageId>SimpleFlux.AzureTables</PackageId>
    <Title>SimpleFlux.AzureTables — Azure Table Storage backend for SimpleFlux</Title>
    <Description>Azure Table Storage backend for SimpleFlux, the simple event sourcing library for .NET. Add SimpleFlux for the core abstractions and this package to store streams in Azure Tables.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleFlux\SimpleFlux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>