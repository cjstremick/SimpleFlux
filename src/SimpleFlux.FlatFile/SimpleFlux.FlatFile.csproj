<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ImplicitUsings / Nullable / package metadata come from Directory.Build.props -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>2.0.0</VersionPrefix>
  </PropertyGroup>

  <!-- Per-package NuGet metadata (the rest is shared via Directory.Build.props). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <PackageId>SimpleFlux.FlatFile</PackageId>
    <Title>SimpleFlux.FlatFile — flat-file backend for SimpleFlux</Title>
    <Description>Flat-file storage backend for SimpleFlux, the simple event-sourcing library for .NET. Stores streams as JSONL files on the local filesystem. Zero external dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\SimpleFlux\\SimpleFlux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
