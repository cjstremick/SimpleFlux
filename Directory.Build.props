<Project>

  <!--
    Shared settings for every project in the repo.
    Per-package metadata that should NOT be shared lives in the project file
    (e.g. PackageId and Title for the packable library).
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Cj Stremick</Authors>
    <RepositoryUrl>https://github.com/cjstremick/SimpleFlux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>