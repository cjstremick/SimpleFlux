<Project>

  <!--
    Shared settings for every project in the repo.
    NuGet package metadata lives in src/SimpleFlux/SimpleFlux.csproj — that file is
    the single source of truth for what consumers see on nuget.org.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>